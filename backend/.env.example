# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
# Application Runtime URL (Least-Privilege Non-Superuser Role: loopbill_app):
# Grants SELECT, INSERT, UPDATE on operational tables; DELETE is strictly revoked on immutable
# financial and audit ledgers (invoices, invoice_lines, payments, audit_logs, subscription_events).
DATABASE_URL="postgresql://loopbill_app:loopbill_app_secret@localhost:5433/loopbill_dev?schema=public"
APP_DATABASE_URL="postgresql://loopbill_app:loopbill_app_secret@localhost:5433/loopbill_dev?schema=public"
TEST_DATABASE_URL="postgresql://loopbill_app:loopbill_app_secret@localhost:5433/loopbill_test?schema=public"
TEST_APP_DATABASE_URL="postgresql://loopbill_app:loopbill_app_secret@localhost:5433/loopbill_test?schema=public"

# Migration / DDL URL (Migration Role: loopbill - NOSUPERUSER, CREATEDB):
# Used during `prisma migrate dev` or deployment migrations:
MIGRATION_DATABASE_URL="postgresql://loopbill:loopbill_secret@localhost:5433/loopbill_dev?schema=public"

# Docker Compose Configuration & Port Remapping:
# By default, docker-compose maps host port 5432 to container port 5432 ("${POSTGRES_PORT:-5432}:5432").
# If host port 5432 is occupied by an existing local service, configure a different host port
# (e.g., POSTGRES_PORT=5434) in your environment without modifying the internal container port:
# POSTGRES_PORT=5434
# DATABASE_URL="postgresql://loopbill_app:loopbill_app_secret@localhost:5434/loopbill_dev?schema=public"
# APP_DATABASE_URL="postgresql://loopbill_app:loopbill_app_secret@localhost:5434/loopbill_dev?schema=public"
# TEST_DATABASE_URL="postgresql://loopbill_app:loopbill_app_secret@localhost:5434/loopbill_test?schema=public"
# TEST_APP_DATABASE_URL="postgresql://loopbill_app:loopbill_app_secret@localhost:5434/loopbill_test?schema=public"
# MIGRATION_DATABASE_URL="postgresql://loopbill:loopbill_secret@localhost:5434/loopbill_dev?schema=public"

# Security & Secrets
JWT_SECRET="dev_jwt_secret_min_32_characters_long_for_security"
COOKIE_SECRET="dev_cookie_secret_min_32_characters_long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS & Client
CLIENT_URL="http://localhost:3000"

# Logging
LOG_LEVEL="debug"
